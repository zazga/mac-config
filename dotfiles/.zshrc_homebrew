# Package manager PATH for Apple Silicon (Homebrew) and Intel (MacPorts).
if [[ "$(uname -m)" == arm64 && -x /opt/homebrew/bin/brew ]]; then
  eval "$(/opt/homebrew/bin/brew shellenv)"
elif [[ "$(uname -m)" == x86_64 && -d /opt/local/bin ]]; then
  path=(/opt/local/bin /opt/local/sbin $path)
  typeset -U path
fi
