{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "BuildConfig",
  "type": "object",
  "properties": {
    "apiVersion": {
      "const": "build.openshift.io/v1"
    },
    "kind": {
      "const": "BuildConfig"
    },
    "metadata": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "namespace": {
          "type": "string"
        },
        "labels": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "annotations": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      }
    },
    "spec": {
      "type": "object",
      "properties": {
        "runPolicy": {
          "enum": [
            "Serial",
            "SerialLatestOnly",
            "Parallel"
          ]
        },
        "source": {
          "type": "object",
          "properties": {
            "type": {
              "type": "string"
            },
            "git": {
              "type": "object",
              "properties": {
                "uri": {
                  "type": "string"
                },
                "ref": {
                  "type": "string"
                }
              }
            },
            "contextDir": {
              "type": "string"
            },
            "sourceSecret": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string"
                }
              }
            },
            "dockerfile": {
              "type": "string"
            }
          }
        },
        "strategy": {
          "type": "object",
          "properties": {
            "type": {
              "type": "string"
            },
            "sourceStrategy": {
              "type": "object",
              "properties": {
                "from": {
                  "type": "object",
                  "properties": {
                    "kind": {
                      "type": "string"
                    },
                    "name": {
                      "type": "string"
                    }
                  }
                },
                "env": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "name": {
                        "type": "string"
                      },
                      "value": {
                        "type": "string"
                      }
                    }
                  }
                }
              }
            },
            "dockerStrategy": {
              "type": "object",
              "properties": {
                "dockerfilePath": {
                  "type": "string"
                },
                "from": {
                  "type": "object",
                  "properties": {
                    "kind": {
                      "type": "string"
                    },
                    "name": {
                      "type": "string"
                    }
                  }
                }
              }
            },
            "customStrategy": {
              "type": "object",
              "properties": {
                "from": {
                  "type": "object",
                  "properties": {
                    "kind": {
                      "type": "string"
                    },
                    "name": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        },
        "output": {
          "type": "object",
          "properties": {
            "to": {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string"
                },
                "name": {
                  "type": "string"
                }
              }
            }
          }
        },
        "triggers": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "type": {
                "type": "string"
              },
              "imageChange": {
                "type": "object"
              },
              "github": {
                "type": "object"
              },
              "generic": {
                "type": "object"
              }
            }
          }
        },
        "successfulBuildsHistoryLimit": {
          "type": "integer"
        },
        "failedBuildsHistoryLimit": {
          "type": "integer"
        },
        "resources": {
          "type": "object"
        },
        "postCommit": {
          "type": "object"
        }
      }
    }
  }
}
