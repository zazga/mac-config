{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "EgressFirewall (autocomplete subset)",
  "description": "Compact non-exhaustive schema for editor completion. No strict rejection of unknown properties. Match cluster CRDs / API version for authoritative validation.",
  "type": "object",
  "properties": {
    "apiVersion": {
      "type": "string",
      "default": "k8s.ovn.org/v1"
    },
    "kind": {
      "const": "EgressFirewall"
    },
    "metadata": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "namespace": {
          "type": "string"
        },
        "labels": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "annotations": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      }
    },
    "spec": {
      "type": "object",
      "properties": {
        "egress": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "enum": [
                  "Allow",
                  "Deny"
                ]
              },
              "to": {
                "type": "object",
                "properties": {
                  "cidrSelector": {
                    "type": "string"
                  },
                  "dnsName": {
                    "type": "string"
                  },
                  "nodeSelector": {
                    "type": "object",
                    "additionalProperties": {
                      "type": "string"
                    }
                  }
                }
              },
              "ports": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "protocol": {
                      "type": "string",
                      "enum": [
                        "TCP",
                        "UDP",
                        "SCTP"
                      ]
                    },
                    "port": {
                      "type": "integer"
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
