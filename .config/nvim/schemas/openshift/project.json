{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Project (autocomplete subset)",
  "description": "Compact non-exhaustive schema for editor completion. No strict rejection of unknown properties. Match cluster CRDs / API version for authoritative validation.",
  "type": "object",
  "properties": {
    "apiVersion": {
      "type": "string",
      "default": "project.openshift.io/v1"
    },
    "kind": {
      "const": "Project"
    },
    "metadata": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "namespace": {
          "type": "string"
        },
        "labels": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "annotations": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      }
    },
    "spec": {
      "type": "object",
      "properties": {
        "finalizers": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
