                          "items": {
                            "type": "string"
                          }
                        },
                        "remoteIpBlocks": {
                          "type": "array",
                          "items": {
                            "type": "string"
                          }
                        },
                        "serviceAccounts": {
                          "type": "array",
                          "items": {
                            "type": "string"
                          }
