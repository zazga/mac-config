                  }
                }
              },
              "when": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "key": {
                      "type": "string"
                    },
                    "values": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "notValues": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    }
