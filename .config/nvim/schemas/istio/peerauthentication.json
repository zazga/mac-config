{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "PeerAuthentication (autocomplete subset)",
  "description": "Compact non-exhaustive schema for editor completion. No strict rejection of unknown properties. Match cluster CRDs / API version for authoritative validation.",
  "type": "object",
  "properties": {
    "apiVersion": {
      "type": "string",
      "default": "security.istio.io/v1"
    },
    "kind": {
      "const": "PeerAuthentication"
    },
    "metadata": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "namespace": {
          "type": "string"
        },
        "labels": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "annotations": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      }
    },
    "spec": {
      "type": "object",
      "properties": {
        "selector": {
          "type": "object",
          "properties": {
            "matchLabels": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            }
          }
        },
        "mtls": {
          "type": "object",
          "properties": {
            "mode": {
              "type": "string",
              "enum": [
                "UNSET",
                "DISABLE",
                "PERMISSIVE",
                "STRICT"
              ]
            }
          }
        },
        "portLevelMtls": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "mode": {
                "type": "string",
                "enum": [
                  "UNSET",
                  "DISABLE",
                  "PERMISSIVE",
                  "STRICT"
                ]
              }
            }
          }
        }
      }
    }
  }
}
