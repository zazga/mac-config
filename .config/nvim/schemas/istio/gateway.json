{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Gateway (autocomplete subset)",
  "description": "Compact non-exhaustive schema for editor completion. No strict rejection of unknown properties. Match cluster CRDs / API version for authoritative validation.",
  "type": "object",
  "properties": {
    "apiVersion": {
      "type": "string",
      "default": "networking.istio.io/v1"
    },
    "kind": {
      "const": "Gateway"
    },
    "metadata": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "namespace": {
          "type": "string"
        },
        "labels": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "annotations": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      }
    },
    "spec": {
      "type": "object",
      "properties": {
        "selector": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "servers": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "port": {
                "type": "object",
                "properties": {
                  "number": {
                    "type": "integer"
                  },
                  "name": {
                    "type": "string"
                  },
                  "protocol": {
                    "type": "string",
                    "enum": [
                      "HTTP",
                      "HTTPS",
                      "HTTP2",
                      "GRPC",
                      "TCP",
                      "TLS"
                    ]
                  }
                }
              },
              "hosts": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "tls": {
                "type": "object",
                "properties": {
                  "mode": {
                    "type": "string",
                    "enum": [
                      "PASSTHROUGH",
                      "SIMPLE",
                      "MUTUAL",
                      "AUTO_PASSTHROUGH",
                      "ISTIO_MUTUAL"
                    ]
                  },
                  "credentialName": {
                    "type": "string"
                  },
                  "httpsRedirect": {
                    "type": "boolean"
                  },
                  "serverCertificate": {
                    "type": "string"
                  },
                  "privateKey": {
                    "type": "string"
                  },
                  "caCertificates": {
                    "type": "string"
                  },
                  "minProtocolVersion": {
                    "type": "string"
                  },
                  "maxProtocolVersion": {
                    "type": "string"
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
